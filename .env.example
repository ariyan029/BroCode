# Database (MongoDB connection string)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/vibecode?retryWrites=true&w=majority"

# NextAuth / Auth.js
AUTH_SECRET="your_generated_auth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI Inference Providers (Automatic Fallback System):
# 1. Local Offline: Ollama (default: http://localhost:11434 with codellama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="codellama:latest"

# 2. Cloud Fallback: Highly recommended for cloud deployment (e.g. Vercel)
# Add at least one of these to enable AI when Ollama is offline:
GEMINI_API_KEY=""
# GROQ_API_KEY=""
# OPENAI_API_KEY=""
